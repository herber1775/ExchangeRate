@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject NavigationManager Nav

<nav class="navbar navbar-dark app-navbar">
    <div class="container">
        <a class="navbar-brand fw-semibold" href="">💱 ExchangeRate</a>

        @if (Auth.IsAuthenticated)
        {
            <div class="d-flex align-items-center gap-3 text-white">
                <span class="small">Hola, @Auth.Username</span>
                <button class="btn btn-sm btn-outline-light" @onclick="Logout">Cerrar sesión</button>
            </div>
        }
    </div>
</nav>

<main class="container py-4">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => Auth.Changed += OnAuthChanged;

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private void Logout()
    {
        Auth.SignOut();
        Nav.NavigateTo("login");
    }

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
