@page "/login"
@inject AuthState Auth
@inject ExchangeApiClient Api
@inject NavigationManager Nav

<PageTitle>Iniciar sesión</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="card-title mb-1">Iniciar sesión</h4>
                <p class="text-muted small">Usuario demo: <code>admin</code> / <code>admin123</code></p>

                <EditForm Model="form" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <InputText class="form-control" @bind-Value="form.Username" autocomplete="username" />
                        <ValidationMessage For="() => form.Username" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <InputText type="password" class="form-control" @bind-Value="form.Password" autocomplete="current-password" />
                        <ValidationMessage For="() => form.Password" />
                    </div>

                    @if (error is not null)
                    {
                        <div class="alert alert-danger py-2">@error</div>
                    }

                    <button type="submit" class="btn btn-primary w-100" disabled="@busy">
                        @(busy ? "Ingresando..." : "Ingresar")
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginForm form = new();
    private string? error;
    private bool busy;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
            Nav.NavigateTo("");
    }

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;

        var result = await Api.LoginAsync(new LoginRequest(form.Username, form.Password));
        busy = false;

        if (!result.IsSuccess)
        {
            error = result.Error;
            return;
        }

        Auth.SignIn(form.Username, result.Value!.Token, result.Value.ExpiresAt);
        Nav.NavigateTo("");
    }
}
